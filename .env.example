# Copy to .env (or set these in your hosting dashboard)
PORT=3000
# Long random string used to sign login tokens. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string
# true = load demo school (classes, students, teachers) on first start
DEMO_DATA=true
# Password for the admin account when DEMO_DATA=false
ADMIN_PASSWORD=admin123
# Where the SQLite file lives
DB_PATH=./data/krillion.db
